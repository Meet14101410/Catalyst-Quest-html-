/* Catalyst Quest – Short CSS */
:root {
  --bg: #0b1020;
  --panel: #0f1724;
  --accent: #7efc7e;
  --text: #d8e9ff;
}

body {
  margin: 0;
  background: var(--bg);
  font-family: system-ui, sans-serif;
  color: var(--text);
  display: flex;
  justify-content: center;
  padding: 20px;
}

.wrap {
  width: 700px;
  background: var(--panel);
  padding: 16px;
  border-radius: 10px;
}

h1 {
  margin: 0;
  color: var(--accent);
  font-size: 20px;
}

.info {
  font-size: 14px;
  opacity: 0.8;
  margin-bottom: 10px;
}

canvas {
  width: 100%;
  height: 400px;
  background: #081423;
  border-radius: 8px;
}

.controls {
  margin-top: 10px;
  display: flex;
  gap: 8px;
  align-items: center;
}

button {
  background: #0b1a30;
  border: 1px solid #203040;
  padding: 6px 12px;
  border-radius: 6px;
  color: var(--text);
  cursor: pointer;
}

button:active {
  transform: scale(0.96);
}

.stat {
  background: #111c2e;
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 14px;
}

.hint {
  font-size: 12px;
  color: #9ab3d5;
}

.footer {
  margin-top: 6px;
  font-size: 12px;
  opacity: 0.7;
}
