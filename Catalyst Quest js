// Catalyst Quest – Short JS
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let W = canvas.width, H = canvas.height;
let keys = {}, running = false, score = 0, time = 60;

const player = { x: W/2, y: H/2, r: 12, speed: 220 };
let catalysts = [];
let hazards = [];
let last = 0;

function rand(a,b){ return Math.random()*(b-a)+a; }
function dist(a,b){ return Math.hypot(a.x-b.x, a.y-b.y); }

function spawn(type){
  return {
    x: rand(20, W-20),
    y: rand(20, H-20),
    r: type==="cat" ? 10 : 12,
    color: type==="cat" ? "#7efc7e" : "#ff6b6b",
    value: type==="cat" ? 10 : -5
  };
}

function start(){
  score = 0;
  time = 60;
  catalysts = [];
  hazards = [];
  player.x = W/2; player.y = H/2;
  running = true;
  last = performance.now();
  setInterval(() => { if(running){ time--; if(time<=0) running=false; } }, 1000);
  requestAnimationFrame(loop);
}

function update(dt){
  // movement
  let dx = (keys.ArrowRight||keys.d ? 1 : 0) - (keys.ArrowLeft||keys.a ? 1 : 0);
  let dy = (keys.ArrowDown||keys.s ? 1 : 0) - (keys.ArrowUp||keys.w ? 1 : 0);
  if(dx || dy){
    let len = Math.hypot(dx,dy);
    player.x += (dx/len)*player.speed*dt;
    player.y += (dy/len)*player.speed*dt;
  }

  // bounds
  player.x = Math.max(player.r, Math.min(W-player.r, player.x));
  player.y = Math.max(player.r, Math.min(H-player.r, player.y));

  // spawn items
  if(Math.random() < 0.02) catalysts.push(spawn("cat"));
  if(Math.random() < 0.015) hazards.push(spawn("haz"));

  // collision
  catalysts = catalysts.filter(o=>{
    if(dist(player,o) < player.r+o.r){ score+=o.value; return false; }
    return true;
  });

  hazards = hazards.filter(o=>{
    if(dist(player,o) < player.r+o.r){ score+=o.value; return false; }
    return true;
  });

  document.getElementById("score").textContent = score;
  document.getElementById("time").textContent = time;
}

function draw(){
  ctx.clearRect(0,0,W,H);

  // catalysts
  catalysts.forEach(o=>{
    ctx.fillStyle = o.color;
    ctx.beginPath(); ctx.arc(o.x,o.y,o.r,0,Math.PI*2); ctx.fill();
  });

  // hazards
  hazards.forEach(o=>{
    ctx.fillStyle = o.color;
    ctx.beginPath(); ctx.arc(o.x,o.y,o.r,0,Math.PI*2); ctx.fill();
  });

  // player
  ctx.fillStyle = "#aee0ff";
  ctx.beginPath();
  ctx.arc(player.x, player.y, player.r, 0, Math.PI*2);
  ctx.fill();
}

function loop(t){
  if(!running) return;
  let dt = (t-last)/1000; last=t;
  update(dt);
  draw();
  requestAnimationFrame(loop);
}

window.addEventListener("keydown", e=>keys[e.key]=true);
window.addEventListener("keyup", e=>keys[e.key]=false);
document.getElementById("startBtn").onclick = start;

// initial draw
draw();
